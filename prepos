const DEFAULT = {
  targets:{water:128,steps:10000,showDate:"2026-11-14"},
  meals:[
    {name:"Meal 1",details:"Enter your coach meal"},
    {name:"Meal 2",details:"Enter your coach meal"},
    {name:"Meal 3",details:"Enter your coach meal"},
    {name:"Meal 4",details:"Enter your coach meal"},
    {name:"Meal 5",details:"Enter your coach meal"}
  ],
  workoutDays:{
    "Push":[["Incline Press","3","8-12"],["Machine Chest Press","3","8-12"],["Lateral Raise","4","12-20"],["Triceps Pressdown","3","10-15"]],
    "Pull":[["Lat Pulldown","3","8-12"],["Chest-Supported Row","3","8-12"],["Rear Delt Fly","4","12-20"],["Cable Curl","3","10-15"]],
    "Legs":[["Hack Squat","4","6-10"],["Romanian Deadlift","3","8-12"],["Leg Press","3","10-15"],["Leg Curl","3","10-15"],["Calf Raise","4","10-15"]],
    "Rest / Cardio":[["Cardio","1","Coach target"],["Posing","1","15-30 min"]]
  },
  notes:"",
  logs:{}
};

const clone = x => JSON.parse(JSON.stringify(x));
let state = JSON.parse(localStorage.getItem("preposState") || "null") || clone(DEFAULT);
state.targets = {...DEFAULT.targets,...(state.targets||{})};
state.meals = state.meals?.length ? state.meals : clone(DEFAULT.meals);
state.workoutDays = state.workoutDays || clone(DEFAULT.workoutDays);
state.logs = state.logs || {};

const todayKey = () => new Date().toISOString().slice(0,10);
const today = () => {
  const k=todayKey();
  state.logs[k] ||= {meals:{},tasks:{},water:0,workout:{},weight:"",sleep:"",steps:""};
  return state.logs[k];
};
const save = () => {localStorage.setItem("preposState",JSON.stringify(state)); renderAll();};

document.getElementById("todayLabel").textContent = new Date().toLocaleDateString(undefined,{weekday:"long",month:"long",day:"numeric"});
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{
  document.querySelectorAll(".tab,.tab-panel").forEach(x=>x.classList.remove("active"));
  b.classList.add("active"); document.getElementById(b.dataset.tab).classList.add("active");
  if(b.dataset.tab==="progress") drawChart();
});

const tasks=[
  ["training","Training completed"],
  ["cardio","Cardio completed"],
  ["posing","Posing practice"],
  ["supplements","Supplements taken"],
  ["checkin","Morning check-in saved"]
];

function renderMeals(){
  const log=today(), host=document.getElementById("mealList"); host.innerHTML="";
  let done=0;
  state.meals.forEach((m,i)=>{
    if(log.meals[i]) done++;
    const row=document.createElement("label"); row.className="check-row "+(log.meals[i]?"done":"");
    row.innerHTML=`<input type="checkbox" ${log.meals[i]?"checked":""}><span><strong>${escapeHtml(m.name)}</strong><small>${escapeHtml(m.details)}</small></span>`;
    row.querySelector("input").onchange=e=>{log.meals[i]=e.target.checked;save()};
    host.appendChild(row);
  });
  document.getElementById("mealCount").textContent=`${done}/${state.meals.length}`;
}
function renderTasks(){
  const log=today(), host=document.getElementById("taskList");host.innerHTML="";
  tasks.forEach(([key,label])=>{
    const row=document.createElement("label");row.className="check-row "+(log.tasks[key]?"done":"");
    row.innerHTML=`<input type="checkbox" ${log.tasks[key]?"checked":""}><span><strong>${label}</strong></span>`;
    row.querySelector("input").onchange=e=>{log.tasks[key]=e.target.checked;save()};
    host.appendChild(row);
  });
}
function renderTodayInputs(){
  const log=today();
  weightInput.value=log.weight||"";sleepInput.value=log.sleep||"";stepsInput.value=log.steps||"";
  waterTotal.textContent=`${log.water||0} oz`; waterGoalLabel.textContent=state.targets.water;
  waterBar.style.width=`${Math.min(100,(log.water||0)/state.targets.water*100)}%`;
}
document.getElementById("saveCheckin").onclick=()=>{
  const log=today(); log.weight=weightInput.value;log.sleep=sleepInput.value;log.steps=stepsInput.value;log.tasks.checkin=true;save();
};
document.querySelectorAll("[data-water]").forEach(b=>b.onclick=()=>{today().water=(today().water||0)+Number(b.dataset.water);save()});
resetWater.onclick=()=>{today().water=0;save()};

function calcScore(){
  const l=today(); const mealTotal=state.meals.length||1;
  const mealScore=Object.values(l.meals).filter(Boolean).length/mealTotal;
  const taskScore=tasks.filter(([k])=>l.tasks[k]).length/tasks.length;
  const waterScore=Math.min(1,(l.water||0)/state.targets.water);
  const stepsScore=Math.min(1,(Number(l.steps)||0)/state.targets.steps);
  const sleepScore=Math.min(1,(Number(l.sleep)||0)/8);
  const score=Math.round((mealScore*.35+taskScore*.35+waterScore*.1+stepsScore*.1+sleepScore*.1)*100);
  scoreValue.textContent=score+"%";scoreRing.style.background=`conic-gradient(var(--accent) ${score}%,#232a33 0)`;
}

function setupWorkout(){
  workoutDay.innerHTML=Object.keys(state.workoutDays).map(k=>`<option>${k}</option>`).join("");
  workoutDay.onchange=renderWorkout;
  renderWorkout();
}
function renderWorkout(){
  const day=workoutDay.value||Object.keys(state.workoutDays)[0], host=exerciseList;host.innerHTML="";
  const saved=today().workout[day]||[];
  state.workoutDays[day].forEach((ex,i)=>{
    const x=saved[i]||{};
    const div=document.createElement("div");div.className="exercise";
    div.innerHTML=`<div class="exercise-title">${escapeHtml(ex[0])} · ${ex[1]} sets · ${ex[2]}</div>
      <div class="exercise-grid">
      <input placeholder="Weight" value="${x.weight||""}">
      <input placeholder="Set 1 reps" value="${x.r1||""}">
      <input placeholder="Set 2 reps" value="${x.r2||""}">
      <input placeholder="Set 3 reps" value="${x.r3||""}">
      </div>`;
    host.appendChild(div);
  });
}
saveWorkout.onclick=()=>{
  const day=workoutDay.value;
  today().workout[day]=[...document.querySelectorAll(".exercise")].map(div=>{
    const a=div.querySelectorAll("input"); return {weight:a[0].value,r1:a[1].value,r2:a[2].value,r3:a[3].value};
  });
  today().tasks.training=true; save();
};

function renderHistory(){
  const host=historyList;host.innerHTML="";
  Object.entries(state.logs).sort((a,b)=>b[0].localeCompare(a[0])).slice(0,14).forEach(([date,l])=>{
    const div=document.createElement("div");div.className="history-item";
    div.innerHTML=`<span><strong>${date}</strong><br><small>${l.sleep||"-"} hr sleep · ${l.steps||"-"} steps</small></span><strong>${l.weight||"-"} lb</strong>`;
    host.appendChild(div);
  });
}
function drawChart(){
  const c=weightChart,ctx=c.getContext("2d"),dpr=window.devicePixelRatio||1;
  const cssW=c.clientWidth||640,cssH=280;c.width=cssW*dpr;c.height=cssH*dpr;ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,cssW,cssH);
  const data=Object.entries(state.logs).filter(([,l])=>Number(l.weight)).sort((a,b)=>a[0].localeCompare(b[0])).slice(-30);
  ctx.strokeStyle="#28323d";ctx.lineWidth=1;
  for(let i=0;i<5;i++){let y=30+i*50;ctx.beginPath();ctx.moveTo(36,y);ctx.lineTo(cssW-12,y);ctx.stroke()}
  if(data.length<2){ctx.fillStyle="#9aa4af";ctx.font="14px sans-serif";ctx.fillText("Log at least two weigh-ins to see your trend.",36,145);return}
  const vals=data.map(x=>Number(x[1].weight)),min=Math.min(...vals)-1,max=Math.max(...vals)+1;
  const pts=vals.map((v,i)=>[36+i*(cssW-56)/(vals.length-1),240-(v-min)/(max-min)*190]);
  ctx.strokeStyle="#ef4444";ctx.lineWidth=3;ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke();
  ctx.fillStyle="#f5f7fa";pts.forEach(p=>{ctx.beginPath();ctx.arc(...p,3,0,Math.PI*2);ctx.fill()});
}
clearWeight.onclick=()=>{if(confirm("Clear all saved weights?")){Object.values(state.logs).forEach(x=>x.weight="");save()}};

function renderSettings(){
  waterGoalInput.value=state.targets.water;stepGoalInput.value=state.targets.steps;showDateInput.value=state.targets.showDate;notesInput.value=state.notes||"";
  mealEditor.innerHTML="";
  state.meals.forEach((m,i)=>{
    const div=document.createElement("div");div.className="meal-edit";
    div.innerHTML=`<div><input data-name value="${escapeAttr(m.name)}"><input data-detail value="${escapeAttr(m.details)}"></div><button data-remove="${i}">×</button>`;
    mealEditor.appendChild(div);
  });
  mealEditor.querySelectorAll("[data-remove]").forEach(b=>b.onclick=()=>{state.meals.splice(Number(b.dataset.remove),1);renderSettings()});
}
saveTargets.onclick=()=>{state.targets={water:Number(waterGoalInput.value)||128,steps:Number(stepGoalInput.value)||10000,showDate:showDateInput.value};save()};
addMeal.onclick=()=>{state.meals.push({name:`Meal ${state.meals.length+1}`,details:""});renderSettings()};
saveMeals.onclick=()=>{state.meals=[...mealEditor.querySelectorAll(".meal-edit")].map(x=>({name:x.querySelector("[data-name]").value,details:x.querySelector("[data-detail]").value}));save()};
saveNotes.onclick=()=>{state.notes=notesInput.value;save()};

function renderCountdown(){
  const diff=Math.ceil((new Date(state.targets.showDate+"T12:00:00")-new Date())/86400000);
  countdown.textContent=diff>=0?`${diff} days until show day`:`Show date passed ${Math.abs(diff)} days ago`;
}
exportData.onclick=()=>{
  const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`prepos-backup-${todayKey()}.json`;a.click();URL.revokeObjectURL(a.href);
};
importData.onchange=e=>{
  const file=e.target.files[0];if(!file)return;const r=new FileReader();
  r.onload=()=>{try{state=JSON.parse(r.result);save();setupWorkout()}catch{alert("That backup file could not be read.")}};r.readAsText(file);
};
function escapeHtml(s=""){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function escapeAttr(s=""){return escapeHtml(s)}
function renderAll(){renderMeals();renderTasks();renderTodayInputs();calcScore();renderHistory();renderSettings();renderCountdown();if(document.getElementById("progress").classList.contains("active"))drawChart()}
let deferredPrompt;window.addEventListener("beforeinstallprompt",e=>{e.preventDefault();deferredPrompt=e;installBtn.classList.remove("hidden")});
installBtn.onclick=async()=>{if(deferredPrompt){deferredPrompt.prompt();deferredPrompt=null;installBtn.classList.add("hidden")}};
if("serviceWorker" in navigator)navigator.serviceWorker.register("sw.js");
setupWorkout();renderAll();

const CACHE="prepos-v1";const ASSETS=["./","index.html","style.css","app.js","manifest.json","icon-192.svg","icon-512.svg"];
self.addEventListener("install",e=>e.waitUntil(caches.open(CACHE).then(c=>c.addAll(ASSETS))));
self.addEventListener("fetch",e=>e.respondWith(caches.match(e.request).then(r=>r||fetch(e.request))));

